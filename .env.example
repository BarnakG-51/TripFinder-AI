# Trip Planner AI - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Tavily API Key - Used for web search (hotels, flights, restaurants, travel spots)
# Get your API key from: https://tavily.com
TAVILY_API_KEY="your_tavily_api_key_here"

# Google Maps API Key - Used for distance calculations and route planning
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# Groq API Key - Used for LLM-powered trip planning and itinerary generation
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
